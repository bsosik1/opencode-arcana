{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "file:///absolute/path/to/arcana",
      {
        "agents": {
          "magician": {
            "model": "openai/gpt-5.6-sol",
            "variant": "xhigh",
            "permission": {
              "bash": {
                "git add*": "allow",
                "git commit*": "allow",
                "git push*": "allow",
                "git merge-base*": "allow",
                "git branch --show-current*": "allow",
